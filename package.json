{
	"name": "sveltekit-form-examples",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.24.1",
		"prettier": "^3.5.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"sveltekit-superforms": "^3.1.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.3.8",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "24.22.3"
	},
	"type": "module"
